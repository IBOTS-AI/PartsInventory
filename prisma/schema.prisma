// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TransactionType {
  ADD
  REMOVE
  ADJUST
  TRANSFER
  RESERVE
  UNRESERVE
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts PartTag[]

  @@map("tags")
}

model Location {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  locationType String   @default("other")
  description  String?
  color        String   @default("#1d5d70")
  qrCode       String   @unique @default(uuid())
  parentId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[] @relation("LocationHierarchy")

  inventory               Inventory[]
  sourceTransactions      InventoryTransaction[] @relation("TransactionSource")
  destinationTransactions InventoryTransaction[] @relation("TransactionDestination")
  homeForParts            Part[]                 @relation("PartHomeLocation")

  @@index([parentId])
  @@index([locationType])
  @@map("locations")
}

model Part {
  id                     Int      @id @default(autoincrement())
  qrCode                 String   @unique @default(uuid())
  sku                    String?  @unique
  name                   String
  description            String?
  manufacturer           String?
  manufacturerPartNumber String?
  manufacturerUrl        String?
  sourceUrl              String?
  weightGrams            Decimal?
  unitOfMeasure          String   @default("each")
  minimumQuantity        Decimal  @default(0)
  reorderQuantity        Decimal  @default(0)
  notes                  String?
  active                 Boolean  @default(true)
  homeLocationId         Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  homeLocation Location?              @relation("PartHomeLocation", fields: [homeLocationId], references: [id], onDelete: SetNull)
  inventory    Inventory[]
  transactions InventoryTransaction[]

  aliases   PartAlias[]
  suppliers PartSupplier[]
  images    PartImage[]
  tags      PartTag[]

  @@index([homeLocationId])
  @@index([name])
  @@index([manufacturerPartNumber])
  @@map("parts")
}

model PartTag {
  partId Int
  tagId  Int

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([partId, tagId])
  @@index([tagId])
  @@map("part_tags")
}

model Inventory {
  id         Int      @id @default(autoincrement())
  partId     Int
  locationId Int
  quantity   Decimal  @default(0)
  updatedAt  DateTime @updatedAt

  part     Part     @relation(fields: [partId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([partId, locationId])
  @@index([locationId])
  @@map("inventory")
}

model InventoryTransaction {
  id            Int             @id @default(autoincrement())
  partId        Int
  locationId    Int?
  destinationId Int?
  type          TransactionType
  quantity      Decimal
  notes         String?
  operatorName  String?
  createdAt     DateTime        @default(now())

  part        Part      @relation(fields: [partId], references: [id])
  location    Location? @relation("TransactionSource", fields: [locationId], references: [id])
  destination Location? @relation("TransactionDestination", fields: [destinationId], references: [id])

  @@index([partId])
  @@index([locationId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model PartAlias {
  id        Int      @id @default(autoincrement())
  partId    Int
  alias     String
  createdAt DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, alias])
  @@index([alias])
  @@map("part_aliases")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  website   String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts PartSupplier[]

  @@map("suppliers")
}

model PartSupplier {
  id                 Int      @id @default(autoincrement())
  partId             Int
  supplierId         Int
  supplierPartNumber String?
  productUrl         String?
  unitPrice          Decimal?
  preferred          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  part     Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([partId, supplierId])
  @@index([supplierId])
  @@map("part_suppliers")
}

model PartImage {
  id          Int      @id @default(autoincrement())
  partId      Int
  imageType   String
  localPath   String?
  externalUrl String?
  altText     String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("part_images")
}

model LabelTemplate {
  id                     Int      @id @default(autoincrement())
  name                   String   @unique
  target                 String   @default("both")
  showTag                Boolean  @default(true)
  showSku                Boolean  @default(true)
  showManufacturerNumber Boolean  @default(true)
  showLocation           Boolean  @default(true)
  showContents           Boolean  @default(true)
  showQrCode             Boolean  @default(true)
  accentColor            String   @default("#1d5d70")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([target, active])
  @@map("label_templates")
}
